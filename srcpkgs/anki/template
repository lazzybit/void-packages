 2c76c141f678a2e430d1a84aab8931a806f7218b3640ae83c3a2efc6f25dcd61"
nocross=yes
python_version=3

post_extract() {
	shopt -s dotglob
	mv "anki-${version}"/* .
	shopt -u dotglob
	rmdir "anki-${version}"

	rm -rf ftl/core-repo ftl/qt-repo
	mv "anki-core-i18n-${_core_commit}" ftl/core-repo
	mv "anki-desktop-ftl-${_ftl_commit}" ftl/qt-repo

	git init -q
}

pre_build() {
	rm -f out/build.ninja
	cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
	rm -f yarn.lock
	yarn install --modules-folder out/node_modules --ignore-scripts
	ln -sf out/node_modules node_modules
	python3 -m venv --system-site-packages --without-pip out/pyenv
	mkdir -p out
	echo "${version}" > out/buildhash
}

do_build() {
	export CFLAGS+=" -ffat-lto-objects"
	export PYTHON_BINARY=/usr/bin/python3
	export PROTOC_BINARY=/usr/bin/protoc
	export NODE_BINARY=/usr/bin/node
	export YARN_BINARY=/usr/bin/yarn
	export UV_BINARY=/usr/bin/uv
	export RELEASE=2
	export OFFLINE_BUILD=1
	export CARGO_TARGET_DIR="${wrksrc}/out/rust"
	export LIBSQLITE3_SYS_USE_PKG_CONFIG=1
	export ZSTD_SYS_USE_PKG_CONFIG=1

	cargo build -p runner --release
	./out/rust/release/runner build -- wheels -v
}

do_install() {
	for whl in out/wheels/*.whl; do
		python3 -m installer --destdir="${DESTDIR}" "$whl"
	done

	vinstall qt/launcher/lin/anki.desktop 644 usr/share/applications
	vinstall qt/launcher/lin/anki.png 644 usr/share/pixmaps
	vinstall qt/launcher/lin/anki.xpm 644 usr/share/pixmaps
	vinstall qt/launcher/lin/anki.1 644 usr/share/man/man1
	vinstall qt/launcher/lin/anki.xml 644 usr/share/mime/packages
	vlicense LICENSE
}
