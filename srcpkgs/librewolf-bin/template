# Template file for 'librewolf-bin'
pkgname=librewolf-bin
version=151.0.1+2
revision=1
archs="x86_64"
hostmakedepends="tar xz"
depends="desktop-file-utils hicolor-icon-theme dejavu-fonts-ttf"
short_desc="Community-maintained fork of Firefox, focused on privacy, security and freedom"
maintainer="Riley Chang <riley@nomonator.com>"
license="MPL-2.0"
homepage="https://librewolf.net/"
distfiles="https://codeberg.org/api/packages/librewolf/generic/librewolf/${version/\+/-}/librewolf-${version/\+/-}-linux-x86_64-package.tar.xz"
checksum=62a1542942b81a83f624021adda26acff8800260fc861e54a95cdb9b88e3be6f

do_install() {
	vmkdir usr/lib/librewolf
	cp -a ./* "${DESTDIR}/usr/lib/librewolf/"

	vinstall "${FILESDIR}/vendor.js" 644 usr/lib/librewolf/browser/defaults/preferences
	vinstall "${FILESDIR}/distribution.ini" 644 usr/lib/librewolf/distribution
	vinstall "${FILESDIR}/librewolf.desktop" 644 usr/share/applications

	vmkdir usr/bin
	ln -sf /usr/lib/librewolf/librewolf "${DESTDIR}/usr/bin/librewolf"
	ln -sf /usr/bin/librewolf "${DESTDIR}/usr/lib/librewolf/librewolf-bin"

	if [ -e "${DESTDIR}/usr/lib/librewolf/libnssckbi.so" ]; then
		rm -f "${DESTDIR}/usr/lib/librewolf/libnssckbi.so"
		ln -sf /usr/lib/libnssckbi.so "${DESTDIR}/usr/lib/librewolf/libnssckbi.so"
	fi
}
